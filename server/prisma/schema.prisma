// Prisma schema for UbicaDog Database (PostgreSQL / Supabase / Local Docker)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  user
  employee
  admin
}

enum Species {
  dog
  cat
  other
}

enum PetSize {
  small
  medium
  large
}

enum CollarStatus {
  with_collar
  no_collar
  unknown
}

enum AnimalCondition {
  healthy
  injured
  scared
  wandering
}

enum SightingStatus {
  active
  resolved
  hidden
}

enum SubscriptionTier {
  free
  pro_owner
  store_basic
  store_premium
}

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  password         String?
  name             String
  role             Role             @default(user)
  phone            String?
  avatarUrl        String?
  homeAddress      String?
  homeLatitude     Float?
  homeLongitude    Float?
  googleId         String?          @unique
  subscriptionTier SubscriptionTier @default(free)
  pets             Pet[]
  sightings        Sighting[]
  stores           PetStore[]
  subscriptions    Subscription[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([email])
}

model Subscription {
  id                   String           @id @default(uuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 SubscriptionTier @default(free)
  status               String           @default("active")
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime
  priceClp             Int
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([userId])
  @@index([stripeSubscriptionId])
}

model Pet {
  id                String    @id @default(uuid())
  ownerId           String
  owner             User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  species           Species   @default(dog)
  breed             String
  age               Int?
  size              PetSize   @default(medium)
  color             String
  microchipNumber   String?   @unique
  collarDetails     String?
  photoUrl          String
  homeLatitude      Float
  homeLongitude     Float
  homeAddress       String
  isLost            Boolean   @default(false)
  lostSince         DateTime?
  lastSeenLatitude  Float?
  lastSeenLongitude Float?
  description       String?
  rewardAmount      Float?
  qrCodeUrl         String?
  hasPurchasedPlate Boolean   @default(false)
  vaccines          String[]  @default([])
  allergies         String?
  sterilized        Boolean   @default(false)
  medicalNotes      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([ownerId])
  @@index([isLost])
}

model Sighting {
  id           String          @id @default(uuid())
  reporterId   String?
  reporter     User?           @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterName String?
  species      Species         @default(dog)
  breed        String?
  collarStatus CollarStatus    @default(unknown)
  condition    AnimalCondition @default(wandering)
  photoUrl     String
  latitude     Float
  longitude    Float
  address      String?
  seenAt       DateTime        @default(now())
  notes        String?
  contactPhone String?
  status       SightingStatus  @default(active)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([latitude, longitude])
  @@index([status])
}

model Veterinary {
  id             String   @id @default(uuid())
  clinicName     String
  address        String
  latitude       Float
  longitude      Float
  phone          String
  whatsapp       String?
  rating         Float    @default(5.0)
  reviewCount    Int      @default(0)
  isEmergency24h Boolean  @default(false)
  openingHours   String
  photoUrl       String
  services       String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([latitude, longitude])
  @@index([rating])
}

model PetStore {
  id           String           @id @default(uuid())
  ownerId      String?
  owner        User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  businessName String
  tier         SubscriptionTier @default(store_basic)
  address      String
  latitude     Float
  longitude    Float
  phone        String
  whatsapp     String?
  logoUrl      String
  coverUrl     String?
  description  String
  openingHours String
  websiteUrl   String?
  catalog      Json             @default("[]")
  promotions   Json             @default("[]")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([latitude, longitude])
}
